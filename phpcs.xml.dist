<?xml version="1.0"?>
<ruleset name="AutoScribe">
	<description>Coding standards for the AutoScribe plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!--
		Build output. bin/build.sh stages a copy of the plugin here, so scanning
		it reports every class in the plugin as a duplicate of itself.
	-->
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!--
	Parallel running is deliberately not enabled. Its progress counter reports
	worker batches rather than files (33 files displayed as "7 / 7"), which makes
	a clean run look like a run that silently skipped most of the codebase.
	-->


	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>

	<!--
	The plugin autoloads through Composer PSR-4, which requires StudlyCaps file
	names that mirror the class name (src/Plugin.php for AutoScribe\Plugin).
	WordPress.Files.FileName predates Composer and demands lowercase, hyphenated
	class-*.php names, which PSR-4 cannot resolve. The two conventions are
	mutually exclusive, so the sniff is disabled rather than the file layout in
	section 3.1 of the brief being abandoned. No other sniff is relaxed.
	-->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="autoscribe"/>
				<element value="AutoScribe"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="autoscribe"/>
			</property>
		</properties>
	</rule>

	<!--
	Dropping the custom runs table on uninstall has no wpdb wrapper and cannot be
	cached, so the direct-query sniff is unsatisfiable there. Scoped to that one
	file; every other file is still held to it.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/uninstall.php</exclude-pattern>
		<exclude-pattern>*/src/Pipeline/Run.php</exclude-pattern>
		<exclude-pattern>*/src/Cost/Budget_Guard.php</exclude-pattern>
		<exclude-pattern>*/src/Content/Topic_Deduplicator.php</exclude-pattern>
		<!--
		The run log tests need rows with specific started_at values to exercise
		month boundaries and the retention cutoff. Run::start() always stamps the
		current time, so there is no API-level way to create them.
		-->
		<exclude-pattern>*/tests/Pipeline/Run_QueryTest.php</exclude-pattern>
	</rule>

	<!--
	The capability sniff only knows WordPress core capabilities, so it reports the
	plugin's own as possible typos. This is the property the sniff documents for
	the purpose; it teaches the sniff the real names rather than switching it off,
	so a genuine misspelling anywhere in the plugin is still caught.
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="autoscribe_manage_prompts"/>
				<element value="edit_autoscribe_prompt"/>
				<element value="read_autoscribe_prompt"/>
				<element value="delete_autoscribe_prompt"/>
				<element value="edit_autoscribe_prompts"/>
				<element value="edit_others_autoscribe_prompts"/>
				<element value="edit_private_autoscribe_prompts"/>
				<element value="edit_published_autoscribe_prompts"/>
				<element value="publish_autoscribe_prompts"/>
				<element value="read_private_autoscribe_prompts"/>
				<element value="delete_autoscribe_prompts"/>
				<element value="delete_others_autoscribe_prompts"/>
				<element value="delete_private_autoscribe_prompts"/>
				<element value="delete_published_autoscribe_prompts"/>
			</property>
		</properties>
	</rule>

	<!--
	The obfuscation sniff exists to catch base64-encoded malware. OpenAI returns
	generated images as b64_json and Google returns them as inlineData.data, so
	decoding base64 is the documented wire format, not a way of hiding code.
	There is no alternative: the bytes arrive encoded. Scoped to the two image
	adapters and their tests; base64 anywhere else in the plugin is still
	flagged, and Key_Store uses hex rather than base64 so it stays covered.
	-->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
		<exclude-pattern>*/src/Providers/Image/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
		<exclude-pattern>*/tests/Providers/*</exclude-pattern>
	</rule>
</ruleset>
