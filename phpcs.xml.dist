<?xml version="1.0"?>
<ruleset name="AutoScribe">
	<description>Coding standards for the AutoScribe plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<!--
		Build output. bin/build.sh stages a copy of the plugin here, so scanning
		it reports every class in the plugin as a duplicate of itself.
	-->
	<exclude-pattern>/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!--
	Parallel running is deliberately not enabled. Its progress counter reports
	worker batches rather than files (33 files displayed as "7 / 7"), which makes
	a clean run look like a run that silently skipped most of the codebase.
	-->


	<config name="minimum_wp_version" value="6.4"/>

	<rule ref="WordPress"/>
	<rule ref="WordPress-Docs"/>

	<!--
	The plugin autoloads through Composer PSR-4, which requires StudlyCaps file
	names that mirror the class name (src/Plugin.php for AutoScribe\Plugin).
	WordPress.Files.FileName predates Composer and demands lowercase, hyphenated
	class-*.php names, which PSR-4 cannot resolve. The two conventions are
	mutually exclusive, so the sniff is disabled rather than the file layout in
	section 3.1 of the brief being abandoned. No other sniff is relaxed.
	-->
	<rule ref="WordPress.Files.FileName">
		<severity>0</severity>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="autoscribe"/>
				<element value="AutoScribe"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="autoscribe"/>
			</property>
		</properties>
	</rule>

	<!--
	Dropping the custom runs table on uninstall has no wpdb wrapper and cannot be
	cached, so the direct-query sniff is unsatisfiable there. Scoped to that one
	file; every other file is still held to it.
	-->
	<rule ref="WordPress.DB.DirectDatabaseQuery">
		<exclude-pattern>/uninstall.php</exclude-pattern>
		<!--
		The schema migration reads and rewrites rows of the plugin's own table to
		move a counter out of the payload document and into its column. There is
		no wrapper for that, and caching a migration would be meaningless: it runs
		once, before anything else reads the values it is correcting.
		-->
		<exclude-pattern>*/src/Activation.php</exclude-pattern>
		<exclude-pattern>*/src/Pipeline/Run.php</exclude-pattern>
		<exclude-pattern>*/src/Cost/Budget_Guard.php</exclude-pattern>
		<!--
		Spend_Lock takes a named MySQL lock. GET_LOCK has no wpdb wrapper, and
		caching a lock would defeat the point of taking one.
		-->
		<exclude-pattern>*/src/Cost/Spend_Lock.php</exclude-pattern>
		<!--
		Named_Lock is where that GET_LOCK now lives, and the reason is unchanged:
		there is no wpdb wrapper for a named lock, and caching one would defeat
		the point of taking it.
		-->
		<exclude-pattern>*/src/Concurrency/Named_Lock.php</exclude-pattern>
		<!--
		The stall sweep asks Action Scheduler's own table which runs have a queued
		action. Its store exposes no bulk query, and asking one run at a time made
		a bounded sweep into two thousand round trips against the queue it is
		watching. Scoped to that one wrapper, which falls back to the public API
		when the table is not the one it expects.
		-->
		<exclude-pattern>*/src/Scheduling/Scheduler.php</exclude-pattern>
		<exclude-pattern>*/src/Content/Topic_Deduplicator.php</exclude-pattern>
		<!--
		The schedule sweep pages enabled prompts by ID so that every one of them
		gets a turn. WP_Query cannot express "IDs above this one" without a global
		posts_where filter, and caching a recovery scan would defeat its purpose.
		-->
		<exclude-pattern>*/src/Scheduling/Schedule_Sweeper.php</exclude-pattern>
		<!--
		The run log tests need rows with specific started_at values to exercise
		month boundaries and the retention cutoff. Run::start() always stamps the
		current time, so there is no API-level way to create them.
		-->
		<exclude-pattern>*/tests/Pipeline/Run_QueryTest.php</exclude-pattern>
		<!--
		The uninstall test asks the database directly whether the runs table is
		still there. That is the assertion, and there is no wrapper for it.
		-->
		<exclude-pattern>*/tests/UninstallTest.php</exclude-pattern>
		<!--
		The cost accounting tests read the run row back to assert what was written
		to it. Run exposes no getter for cost_cents or the token columns, and
		adding one purely so a test can avoid a direct read would put production
		API in the plugin to serve the test suite.
		-->
		<exclude-pattern>*/tests/Pipeline/Cost_AccountingTest.php</exclude-pattern>
		<!--
		The payload tests read the payload column directly on purpose. Reading it
		back through Run::payload() would let a cache that disagrees with the
		column pass the test, which is the failure the tests exist to catch.
		-->
		<exclude-pattern>*/tests/Pipeline/Run_PayloadTest.php</exclude-pattern>
		<!--
		The stall tests backdate a run's started_at so the sweeper will judge it.
		Run::start() always stamps the current time, and a test that waited a
		quarter of an hour for the threshold would not be a test.
		-->
		<exclude-pattern>*/tests/Pipeline/Stall_SweeperTest.php</exclude-pattern>
		<exclude-pattern>*/tests/Pipeline/Write_FailureTest.php</exclude-pattern>
		<!--
		The concurrency tests backdate a run for the same reason, and one of them
		asserts on the settled cost column directly.
		-->
		<exclude-pattern>*/tests/Pipeline/Concurrent_StateTest.php</exclude-pattern>
		<!--
		The queued-run tests count a prompt's run rows directly, which is the
		assertion: one occurrence opens one run. Run exposes no counter, and
		adding one so a test can avoid a direct read would put production API in
		the plugin to serve the suite.
		-->
		<exclude-pattern>*/tests/Pipeline/Queued_RunTest.php</exclude-pattern>
		<!--
		The migration test drops the column the migration adds and then asks the
		database whether it came back. Both are schema statements about the
		plugin's own table, which is the assertion rather than an implementation
		detail of it.
		-->
		<exclude-pattern>*/tests/Pipeline/Schema_UpgradeTest.php</exclude-pattern>
		<!--
		The interrupted-charge tests backdate a run so the sweeper will judge it,
		and read the settled cost column back.
		-->
		<exclude-pattern>*/tests/Pipeline/Interrupted_ChargeTest.php</exclude-pattern>
		<!--
		The preview tests backdate a preview row so the sweeper will judge it.
		-->
		<exclude-pattern>*/tests/Pipeline/Preview_RunTest.php</exclude-pattern>
		<!--
		The stale-worker test closes a run from inside the query filter, in the
		gap between finalisation's claim and the ownership read it guards. There
		is no API for "issue this statement at this point in another statement's
		execution", which is the whole of what the test does.
		-->
		<exclude-pattern>*/tests/Pipeline/Stale_WorkerTest.php</exclude-pattern>
		<!--
		The two-connection harness manages its own committed data rather than
		relying on the per-test transaction, which means taking a watermark before
		and deleting above it afterwards. Both are direct statements about the
		plugin's own table and about posts, and neither has a wrapper.
		-->
		<exclude-pattern>*/tests/Support/Two_Connection_Test_Case.php</exclude-pattern>

		<!--
		The dispatch tests ask Action Scheduler's own tables what the queue did:
		when the next action comes due, how many finished, how many failed. There
		is no API for those questions that does not go through the store this test
		exists to observe, and the store is emptied the same way for the same
		reason.
		-->
		<exclude-pattern>*/tests/Scheduling/Queue_DispatchTest.php</exclude-pattern>
	</rule>

	<!--
	WP_UNINSTALL_PLUGIN belongs to WordPress, not to this plugin, and uninstall.php
	refuses to run without it. The test that executes uninstall.php therefore has
	to define it, and cannot give it the plugin prefix the sniff wants, because
	then the file under test would not recognise it. Scoped to that one file, so
	every other global the plugin defines is still checked.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedConstantFound">
		<exclude-pattern>*/tests/UninstallTest.php</exclude-pattern>
	</rule>

	<!--
	The queued-run tests fire save_post_autoscribe_prompt directly, to exercise
	the prompt lifecycle the way WordPress does. It is a core hook rather than one
	this plugin invents, and the sniff cannot tell the difference from the call
	site. Scoped to that one file.
	-->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals.NonPrefixedHooknameFound">
		<exclude-pattern>*/tests/Pipeline/Queued_RunTest.php</exclude-pattern>
	</rule>

	<!--
	The capability sniff only knows WordPress core capabilities, so it reports the
	plugin's own as possible typos. This is the property the sniff documents for
	the purpose; it teaches the sniff the real names rather than switching it off,
	so a genuine misspelling anywhere in the plugin is still caught.
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="autoscribe_manage_prompts"/>
				<element value="edit_autoscribe_prompt"/>
				<element value="read_autoscribe_prompt"/>
				<element value="delete_autoscribe_prompt"/>
				<element value="edit_autoscribe_prompts"/>
				<element value="edit_others_autoscribe_prompts"/>
				<element value="edit_private_autoscribe_prompts"/>
				<element value="edit_published_autoscribe_prompts"/>
				<element value="publish_autoscribe_prompts"/>
				<element value="read_private_autoscribe_prompts"/>
				<element value="delete_autoscribe_prompts"/>
				<element value="delete_others_autoscribe_prompts"/>
				<element value="delete_private_autoscribe_prompts"/>
				<element value="delete_published_autoscribe_prompts"/>
			</property>
		</properties>
	</rule>

	<!--
	The obfuscation sniff exists to catch base64-encoded malware. OpenAI returns
	generated images as b64_json and Google returns them as inlineData.data, so
	decoding base64 is the documented wire format, not a way of hiding code.
	There is no alternative: the bytes arrive encoded. Scoped to the two image
	adapters and their tests; base64 anywhere else in the plugin is still
	flagged, and Key_Store uses hex rather than base64 so it stays covered.
	-->
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_decode">
		<exclude-pattern>*/src/Providers/Image/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DiscouragedPHPFunctions.obfuscation_base64_encode">
		<exclude-pattern>*/tests/Providers/*</exclude-pattern>
		<exclude-pattern>*/tests/Pipeline/Write_FailureTest.php</exclude-pattern>
		<!--
		The idempotency tests mock an OpenAI image response, which carries its
		bytes as b64_json. Same documented wire format, same reason.
		-->
		<exclude-pattern>*/tests/Pipeline/Idempotent_StepsTest.php</exclude-pattern>
	</rule>
</ruleset>
